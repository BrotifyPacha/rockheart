# Debian 12 с systemd, имитирует свежий VPS; ansible запускается внутри против localhost
FROM debian:12
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends systemd systemd-sysv python3 python3-venv ca-certificates qrencode \
 && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/ansible \
 && /opt/ansible/bin/pip install --no-cache-dir 'ansible-core>=2.17,<2.19'
COPY requirements.yml /tmp/requirements.yml
RUN /opt/ansible/bin/ansible-galaxy collection install -r /tmp/requirements.yml
ENV PATH=/opt/ansible/bin:$PATH
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
