FROM debian:12-slim
ARG XRAY_VERSION
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip python3 procps \
 && rm -rf /var/lib/apt/lists/*
RUN case "$(dpkg --print-architecture)" in amd64) a=linux-64;; arm64) a=linux-arm64-v8a;; esac \
 && curl -fsSL -o /tmp/xray.zip "https://github.com/XTLS/Xray-core/releases/download/v${XRAY_VERSION}/Xray-${a}.zip" \
 && unzip -q /tmp/xray.zip -d /usr/local/lib/xray && ln -s /usr/local/lib/xray/xray /usr/local/bin/xray \
 && rm /tmp/xray.zip
COPY tests/e2e/link2json.py /usr/local/bin/link2json.py
